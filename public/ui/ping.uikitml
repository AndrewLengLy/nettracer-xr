<!-- Ping controls for both modes. -->
<style>
  .root { flex-direction: column; padding-top: 18px; padding-bottom: 18px; padding-left: 20px; padding-right: 20px; gap: 10px; }
  .title { font-size: 22px; font-weight: 700; color: #1c1d20; }
  .title:dark { color: #fafaf7; }
  .body { font-size: 16px; line-height: 1.35; color: #303136; }
  .body:dark { color: #e4e4e7; }
  .muted { font-size: 15px; line-height: 1.35; color: #55565c; }
  .muted:dark { color: #a1a1aa; }
  .row { flex-direction: row; gap: 8px; flex-wrap: wrap; }
  .col { flex-direction: column; gap: 8px; }
</style>
<Panel class="root" style="width: 290px">
  <span class="title">Send a ping</span>
  <span id="ping-from" class="body">From: PC-A</span>
  <span id="ping-to" class="body">To: SRV</span>
  <span id="ping-hint" class="muted">Point at a device and pull the trigger to make it the destination.</span>
  <div class="row">
    <Button id="btn-pick-from" variant="secondary"><ButtonLabel id="lbl-pick-from">Pick source</ButtonLabel></Button>
    <Button id="btn-send" variant="primary"><ButtonLabel>Send ping</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="btn-internet" variant="secondary"><ButtonLabel>Ping the internet</ButtonLabel></Button>
    <Button id="btn-reset" variant="secondary"><ButtonLabel id="lbl-reset">Reset lab</ButtonLabel></Button>
  </div>
</Panel>
