<!-- Code keypad for My Network. The alphabet leaves out 0, O, 1, I and L. -->
<style>
  .root { flex-direction: column; padding-top: 18px; padding-bottom: 18px; padding-left: 20px; padding-right: 20px; gap: 10px; }
  .title { font-size: 22px; font-weight: 700; color: #1c1d20; }
  .title:dark { color: #fafaf7; }
  .body { font-size: 16px; line-height: 1.35; color: #303136; }
  .body:dark { color: #e4e4e7; }
  .muted { font-size: 15px; line-height: 1.35; color: #55565c; }
  .muted:dark { color: #a1a1aa; }
  .row { flex-direction: row; gap: 8px; flex-wrap: wrap; }
  .col { flex-direction: column; gap: 8px; }
  .code { font-size: 34px; font-weight: 700; letter-spacing: 6px; color: #1c1d20; }
  .code:dark { color: #fafaf7; }
  .key { width: 46px; }
</style>
<Panel class="root" style="width: 480px">
  <span class="title">Enter your scan code</span>
  <span id="kp-code" class="code">- - - - - -</span>
  <span id="kp-status" class="muted">Run the scanner on your PC. It prints a 6-character code.</span>
  <div class="row">
    <Button id="key-A" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>A</ButtonLabel></Button>
    <Button id="key-B" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>B</ButtonLabel></Button>
    <Button id="key-C" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>C</ButtonLabel></Button>
    <Button id="key-D" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>D</ButtonLabel></Button>
    <Button id="key-E" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>E</ButtonLabel></Button>
    <Button id="key-F" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>F</ButtonLabel></Button>
    <Button id="key-G" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>G</ButtonLabel></Button>
    <Button id="key-H" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>H</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="key-J" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>J</ButtonLabel></Button>
    <Button id="key-K" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>K</ButtonLabel></Button>
    <Button id="key-M" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>M</ButtonLabel></Button>
    <Button id="key-N" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>N</ButtonLabel></Button>
    <Button id="key-P" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>P</ButtonLabel></Button>
    <Button id="key-Q" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>Q</ButtonLabel></Button>
    <Button id="key-R" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>R</ButtonLabel></Button>
    <Button id="key-S" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>S</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="key-T" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>T</ButtonLabel></Button>
    <Button id="key-U" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>U</ButtonLabel></Button>
    <Button id="key-V" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>V</ButtonLabel></Button>
    <Button id="key-W" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>W</ButtonLabel></Button>
    <Button id="key-X" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>X</ButtonLabel></Button>
    <Button id="key-Y" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>Y</ButtonLabel></Button>
    <Button id="key-Z" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>Z</ButtonLabel></Button>
    <Button id="key-2" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>2</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="key-3" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>3</ButtonLabel></Button>
    <Button id="key-4" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>4</ButtonLabel></Button>
    <Button id="key-5" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>5</ButtonLabel></Button>
    <Button id="key-6" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>6</ButtonLabel></Button>
    <Button id="key-7" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>7</ButtonLabel></Button>
    <Button id="key-8" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>8</ButtonLabel></Button>
    <Button id="key-9" variant="secondary" class="key" style="width: 46px; min-width: 46px; padding-left: 0px; padding-right: 0px"><ButtonLabel>9</ButtonLabel></Button>
    <Button id="key-del" variant="negative" class="key" style="width: 60px; min-width: 60px; padding-left: 0px; padding-right: 0px"><ButtonLabel>Del</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="btn-kp-load" variant="primary"><ButtonLabel>Load</ButtonLabel></Button>
    <Button id="btn-kp-demo" variant="secondary"><ButtonLabel>Demo network</ButtonLabel></Button>
    <Button id="btn-kp-back" variant="secondary"><ButtonLabel>Back</ButtonLabel></Button>
  </div>
</Panel>
