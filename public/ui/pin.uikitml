<!-- Room pinning, one device at a time. -->
<style>
  .root { flex-direction: column; padding-top: 18px; padding-bottom: 18px; padding-left: 20px; padding-right: 20px; gap: 10px; }
  .title { font-size: 22px; font-weight: 700; color: #1c1d20; }
  .title:dark { color: #fafaf7; }
  .body { font-size: 16px; line-height: 1.35; color: #303136; }
  .body:dark { color: #e4e4e7; }
  .muted { font-size: 15px; line-height: 1.35; color: #55565c; }
  .muted:dark { color: #a1a1aa; }
  .row { flex-direction: row; gap: 8px; flex-wrap: wrap; }
  .col { flex-direction: column; gap: 8px; }
</style>
<Panel class="root" style="width: 330px">
  <span id="pin-progress" class="muted">Device 1 of 1</span>
  <span id="pin-device" class="title">Router, 192.168.1.1</span>
  <span id="pin-hint" class="body">Point at the spot where it really sits, then pull the trigger.</span>
  <div class="row">
    <Button id="btn-pin-back" variant="secondary"><ButtonLabel>Back</ButtonLabel></Button>
    <Button id="btn-pin-skip" variant="secondary"><ButtonLabel>Skip</ButtonLabel></Button>
    <Button id="btn-pin-done" variant="primary"><ButtonLabel>Done</ButtonLabel></Button>
  </div>
  <Button id="btn-pin-clear" variant="negative"><ButtonLabel>Clear saved pins</ButtonLabel></Button>
</Panel>
